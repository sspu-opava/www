---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleSection from '../components/news/ArticleSection.astro';
import EventSection from '../components/events/EventSection.astro';
import HeroTabs from '../components/home/HeroTabs.astro';
import AlertSection from '../components/alerts/AlertSection.astro';
import { resolveHomepageAlerts } from '../data/alerts';
import { entries, formatDate, withBase } from '../lib/content';
const [articles, galleries, eventEntries] = await Promise.all([entries('articles'), entries('galleries'), entries('events')]);
const events = eventEntries;
const alerts = resolveHomepageAlerts(articles);
const homepageArticles = [...articles].sort((a, b) => Number(b.data.homepage.featured) - Number(a.data.homepage.featured) || (a.data.homepage.featured && b.data.homepage.featured ? a.data.homepage.order - b.data.homepage.order : 0) || Number(b.data.publishedAt) - Number(a.data.publishedAt)).slice(0, 6);
const homepageGalleries = galleries.slice(0, 4);
---
<BaseLayout title="SŠPU Opava" description="Technika, digitální svět a tvorba. Poznejte pět oborů Střední školy průmyslové a umělecké v Opavě.">
  <HeroTabs />
  <AlertSection alerts={alerts} />

  <ArticleSection articles={homepageArticles} title="Školní zpravodaj" titleStyle="eyebrow" href="/aktuality/" linkLabel="Všechny aktuality" variant="homepage" background="mist" />

  <section class="container-page grid gap-8 py-12 lg:grid-cols-2 lg:items-start">
    <EventSection embedded events={events} title="Kalendář akcí" variant="homepage" limit={3} from="now" showMoreLink={false} showCalendarLink={true} />
    <aside class="rounded-3xl bg-brand p-7 text-white sm:p-9"><p class="text-sm font-bold uppercase tracking-wider text-white/70">Pro uchazeče</p><h2 class="mt-4 text-3xl text-white">Nejlepší způsob, jak si vybrat? Přijít se podívat.</h2><p class="mt-4 leading-7 text-white/80">Seznamte se s ateliéry, dílnami, laboratořemi i lidmi, kteří budou u vašeho studia.</p><a href={withBase('/uchazeci/')} class="button-primary mt-7 !bg-white !text-night hover:!bg-accent">Přijímací řízení</a></aside>
  </section>

  <section class="bg-night py-10 text-white"><div class="container-page"><div class="flex items-end justify-between gap-5"><div><p class="eyebrow !text-accent">Škola obrazem</p><h2 class="mt-2 text-white">Prostor pro práci i nápady</h2></div><a class="font-bold text-white" href={withBase('/galerie/')}>Všechny galerie →</a></div><div class="mt-8 grid gap-5 md:grid-cols-2">{homepageGalleries.map((gallery) => <a href={withBase(`/galerie/${gallery.id}/`)} class="group relative overflow-hidden rounded-3xl no-underline"><ResponsiveImage src={gallery.data.cover} alt="" class="h-64 w-full object-cover opacity-80 transition duration-300 group-hover:scale-105 group-hover:opacity-100" loading="lazy"/><span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-night/90 px-6 pb-6 pt-20"><span class="text-sm font-bold text-accent">{formatDate(gallery.data.date)}</span><strong class="mt-1 block font-display text-2xl text-white">{gallery.data.title}</strong></span></a>)}</div></div></section>

  <section class="container-page py-10"><p class="eyebrow">Rychlý rozcestník</p><div class="mt-6 grid gap-4 md:grid-cols-3"><a href={withBase('/uchazeci/')} class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Uchazeči</h2><p class="mt-3 leading-7 text-ink/70">Obory, přijímačky a dny otevřených dveří.</p></a><a href={withBase('/studenti/')} class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Studenti a rodiče</h2><p class="mt-3 leading-7 text-ink/70">Dokumenty, podpora a školní systémy.</p></a><a href={withBase('/kontakt/')} class="card p-6 no-underline hover:border-brand"><h2 class="text-2xl">Veřejnost a partneři</h2><p class="mt-3 leading-7 text-ink/70">Kontakty, spolupráce a informace o škole.</p></a></div></section>
</BaseLayout>
