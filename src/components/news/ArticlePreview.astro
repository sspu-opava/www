---
import type { CollectionEntry } from 'astro:content';
import { formatDate, withBase } from '../../lib/content';
import ArticleMedia from './ArticleMedia.astro';

type Article = CollectionEntry<'articles'>;
type Variant = 'default' | 'compact' | 'featured' | 'homepage';

interface Props {
  article: Article;
  /** Kept for backwards-compatible composition APIs; all previews share the homepage presentation. */
  variant?: Variant;
  deferred?: boolean;
}

const { article, deferred = false } = Astro.props;
const articleUrl = withBase(`/aktuality/${article.id}/`);
const mediaImageClass = 'news-card-homepage-image transition duration-500 group-hover:scale-[1.03]';
---

<article
  class:list={[
    'group news-card-homepage min-w-0 overflow-hidden border-t border-ink/15 bg-white/60 transition-colors hover:border-ink/35'
  ]}
  data-news-card
  data-category={article.data.categories.join('|')}
  data-program={article.data.programs.join('|')}
  data-year={article.data.publishedAt.getFullYear()}
  data-author={article.data.author}
  data-tags={article.data.tags.join('|')}
  data-title={article.data.title.toLocaleLowerCase('cs-CZ')}
  data-news-deferred={deferred ? 'true' : undefined}
  hidden={deferred}
>
  <ArticleMedia
    article={article}
    alt=""
    class="h-40 w-full sm:h-44"
    imageClass={mediaImageClass}
  />
  <div class="p-4 sm:p-5">
    <div class="text-xs text-ink/60">
      <time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time>
    </div>
    <h3 class="mt-2 text-lg leading-snug">
      <a href={articleUrl} class="no-underline hover:text-brand">{article.data.title}</a>
    </h3>
    <p class="mt-2 text-sm leading-6 text-ink/70">{article.data.description}</p>
    {article.data.categories.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5" aria-label="Kategorie">
      {article.data.categories.map((item) => <span class="rounded-sm border border-ink/10 bg-ink/5 px-2 py-1 text-[0.68rem] font-medium text-ink/60">{item}</span>)}
    </div>}
    <a href={articleUrl} class="mt-4 inline-flex text-sm font-semibold text-brand no-underline transition group-hover:text-school-magenta">
      Podrobnosti <span aria-hidden="true" class="ml-2">→</span>
    </a>
  </div>
</article>
