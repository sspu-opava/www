---
import { utilityLinks } from '../../data/navigation';
---

<div class="hidden bg-night text-white xl:block">
  <div class="container-page flex min-h-10 items-center justify-between gap-4">
    <p class="text-xs font-semibold tracking-wide text-white/70">Střední škola průmyslová a umělecká, Opava</p>
    <nav aria-label="Online služby" class="flex items-center gap-1.5">
      {utilityLinks.map((link) => <a class="quick-link" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.shortLabel}>
        {link.id === 'facebook' && <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M13.6 21v-8h2.7l.4-3.1h-3.1V7.95c0-.9.25-1.5 1.55-1.5H16.8V3.67c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.05 1.47-4.05 4.17V9.9H7.6V13h2.73v8h3.27Z" /></svg>}
        {link.id === 'moodle' && <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 9 9-5 9 5-9 5-9-5Z" /><path d="M6 11v5.5c3.6 2.3 8.4 2.3 12 0V11M21 9v6" /></svg>}
        {link.id === 'office' && <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h8v8H3V3Zm10 0h8v8h-8V3ZM3 13h8v8H3v-8Zm10 0h8v8h-8v-8Z" /></svg>}
        {link.id === 'skola-online' && <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8 12 2.5 2.5L16.5 9" /></svg>}
        <span class="sr-only">{link.shortLabel}</span>
      </a>)}
    </nav>
  </div>
</div>
