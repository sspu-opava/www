---
import { withBase } from '../../lib/content';
import UtilityNav from './UtilityNav.astro';
import MainNavigation from './MainNavigation.astro';
import SearchPanel from './SearchPanel.astro';
import MobileMenu from './MobileMenu.astro';
---

<a class="skip-link" href="#main-content">Přeskočit na obsah</a>
<header data-pagefind-ignore class="relative z-30 border-b border-ink/10 bg-white shadow-[0_12px_35px_-30px_rgb(7_27_49/70%)]">
  <UtilityNav />
  <div class="container-page relative flex min-h-24 items-center gap-4 py-4 sm:min-h-28 sm:gap-6">
    <a href={withBase('/')} class="shrink-0 no-underline" aria-label="SŠPU Opava – úvodní stránka">
      <img src={withBase('/images/sspu-logo.png')} alt="SŠPU – Střední škola průmyslová a umělecká, Opava" width="560" height="166" class="h-auto w-[min(15.5rem,62vw)] sm:w-[17rem] xl:w-[15rem]" />
    </a>
    <MainNavigation />
    <div class="ml-auto flex items-center gap-2">
      <SearchPanel />
      <MobileMenu />
    </div>
  </div>
</header>
