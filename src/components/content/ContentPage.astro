---
import { render } from 'astro:content';
import { entries } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentRenderer from './ContentRenderer.astro';
import PageHero from './PageHero.astro';
import PersonDialog from '../people/PersonDialog.astro';

interface Props {
  page: any;
  heroIcon?: string;
  accent?: string;
  eyebrow?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { page, heroIcon, accent = '#59BDDC', eyebrow, breadcrumbs = [] } = Astro.props;
const { Content } = await render(page);
const people = await entries('people');
const peopleBlocks = page.data.contentBlocks.filter((block: { type: string }) => block.type === 'people') as { people: string[] }[];
const pagePeople = people.filter((person) => peopleBlocks.some((block) => block.people.includes(person.id)));
---
<BaseLayout title={page.data.title} description={page.data.description} seo={page.data.seo} breadcrumbs={breadcrumbs}>
  <PageHero eyebrow={eyebrow ?? page.data.eyebrow ?? 'Škola'} title={page.data.title} description={page.data.highlight ?? page.data.description} accent={accent} icon={heroIcon} iconBackground="#001731" variant={page.id === 'historie-soucasnost' ? 'history' : 'default'} />
  <article class="container-page pb-14 sm:pb-20" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="typ">Stránka</span>
    <div class="mt-10"><ContentRenderer blocks={page.data.contentBlocks}><Content /></ContentRenderer></div>
    {pagePeople.map((person) => <PersonDialog person={person} />)}
  </article>
</BaseLayout>
