---
import ResponsiveImage from '../ResponsiveImage.astro';
import { formatDate, withBase } from '../../lib/content';

interface GalleryLike {
  id: string;
  data: {
    title: string;
    description: string;
    date: Date;
    cover: string;
  };
}

const { galleries } = Astro.props as { galleries: GalleryLike[] };
---
<div class="mt-10 grid gap-6 md:grid-cols-2">
  {galleries.map((gallery) => <article class="group overflow-hidden rounded-3xl border border-ink/10 bg-night shadow-lift"><div class="overflow-hidden"><ResponsiveImage src={gallery.data.cover} alt={gallery.data.title} class="h-72 w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" loading="lazy" /></div><div class="border-t-4 border-t-school-magenta p-6 text-white"><p class="meta-label !text-school-lime">{formatDate(gallery.data.date)}</p><h2 class="mt-2 text-3xl text-white"><a href={withBase(`/galerie/${gallery.id}/`)} class="no-underline">{gallery.data.title}</a></h2><p class="mt-3 leading-7 text-white/75">{gallery.data.description}</p><a class="mt-5 inline-flex font-bold text-white no-underline transition group-hover:text-school-cyan" href={withBase(`/galerie/${gallery.id}/`)}>Otevřít galerii <span aria-hidden="true" class="ml-2">→</span></a></div></article>)}
</div>
