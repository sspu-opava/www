---
import AttachmentLink from '../content/AttachmentLink.astro';
import { withBase } from '../../lib/content';

interface LinkItem {
  label: string;
  url: string;
  type?: 'external' | 'document' | 'video';
}

const { links } = Astro.props as { links: LinkItem[] };
const isDocument = (link: LinkItem) => link.type === 'document' || /\.(?:pdf|docx?|xlsx?|pptx?|zip)$/i.test(link.url.split(/[?#]/)[0]);
---

{links.length > 0 && <section class="project-detail-section" aria-labelledby="project-links-title">
  <p class="section-label">Odkazy</p>
  <h2 id="project-links-title" class="mt-2">Související informace</h2>
  <ul class="project-links-list">
    {links.map((link) => <li>
      {isDocument(link)
        ? <AttachmentLink label={link.label} url={link.url} class="project-link-card"><span>{link.label}</span><span class="project-link-type">Dokument · náhled</span></AttachmentLink>
        : <a href={withBase(link.url)} class="project-link-card" target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}><span>{link.label}</span><span class="project-link-type">{link.type === 'video' ? 'Video' : 'Externí odkaz'} <span aria-hidden="true">↗</span></span></a>}
    </li>)}
  </ul>
</section>}
