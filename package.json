{
  "name": "sspu-opava-modern-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moderní prototyp veřejného webu SŠPU Opava postavený na Astro a Git-based obsahu.",
  "scripts": {
    "dev": "npm run media:prepare && astro dev",
    "start": "npm run dev",
    "build": "npm run media:prepare && astro build && npm run search:index && npm run check:search",
    "preview": "astro preview",
    "cms": "decap-server",
    "search:index": "node scripts/index-search.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:pages-cms": "node scripts/validate-pages-config.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "check:search": "node scripts/check-search.mjs",
    "media:optimize": "npm run media:prepare",
    "media:convert": "node scripts/convert-jpg-to-webp.mjs",
    "check": "npm run check:content && npm run check:pages-cms && astro check",
    "test": "npm run lint && npm run test:unit && npm run check && npm run build && npm run check:links",
    "gallery:create": "node scripts/create-gallery.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.16.6",
    "decap-cms-app": "^3.6.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^6.3.11",
    "@eslint/js": "^10.0.1",
    "decap-server": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "parse5": "^7.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "yaml": "^2.9.0"
  }
}
